<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tm_background"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/btnClosePacks"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:alpha="0.6"
            android:background="@drawable/bg_home_social_circle"
            android:contentDescription="@string/cd_close"
            android:padding="14dp"
            android:src="@drawable/ic_close"
            app:tint="@android:color/white" />

        <LinearLayout
            android:id="@+id/packsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="68dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/packs_title"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="36sp"
                android:textStyle="bold|italic"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.25"
                android:text="@string/packs_subtitle"
                android:textAllCaps="true"
                android:textColor="@color/tm_pink"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSelectedPacksCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_game_player_badge"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="@string/packs_selected_count_placeholder"
                android:textColor="@color/tm_pink"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCreateCustomPack"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_below="@id/packsHeader"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_players_pack_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/packs_create_custom"
            android:textAllCaps="true"
            android:textColor="@color/tm_pink"
            android:textSize="12sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvQuestionPacks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_below="@id/btnCreateCustomPack"
            android:layout_above="@id/tvPacksHint"
            android:layout_marginTop="22dp"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/tvPacksHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/btnSavePacks"
            android:layout_marginBottom="14dp"
            android:gravity="center"
            android:text="@string/packs_hint"
            android:textColor="#55FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSavePacks"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/bg_game_confirm_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/packs_save"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />

    </RelativeLayout>
</layout>