<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tm_background"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <ImageButton
                android:id="@+id/btnCloseAddQuestion"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:alpha="0.6"
                android:background="@drawable/bg_home_social_circle"
                android:contentDescription="@string/cd_close"
                android:padding="14dp"
                android:src="@drawable/ic_close"
                app:tint="@android:color/white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/btnCloseAddQuestion"
                android:layout_marginTop="32dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_question_title"
                    android:textAllCaps="true"
                    android:textColor="@android:color/white"
                    android:textSize="30sp"
                    android:textStyle="bold|italic"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.2"
                    android:text="@string/add_question_subtitle"
                    android:textAllCaps="true"
                    android:textColor="@color/tm_pink"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etQuestionText"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginTop="36dp"
                    android:background="@drawable/bg_players_input"
                    android:gravity="top"
                    android:hint="@string/add_question_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:padding="20dp"
                    android:textColor="@android:color/white"
                    android:textColorHint="#44FFFFFF"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etOptionA"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_players_input"
                    android:hint="@string/add_question_option_a"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textColor="@android:color/white"
                    android:textColorHint="#44FFFFFF" />

                <EditText
                    android:id="@+id/etOptionB"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_players_input"
                    android:hint="@string/add_question_option_b"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textColor="@android:color/white"
                    android:textColorHint="#44FFFFFF" />

                <EditText
                    android:id="@+id/etOptionC"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_players_input"
                    android:hint="@string/add_question_option_c"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textColor="@android:color/white"
                    android:textColorHint="#44FFFFFF" />

                <EditText
                    android:id="@+id/etOptionD"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_players_input"
                    android:hint="@string/add_question_option_d"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textColor="@android:color/white"
                    android:textColorHint="#44FFFFFF" />

                <TextView
                    android:id="@+id/btnSaveCustomQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginTop="32dp"
                    android:background="@drawable/bg_game_confirm_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="@string/add_question_save"
                    android:textAllCaps="true"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black" />

            </LinearLayout>

        </RelativeLayout>
    </ScrollView>
</layout>