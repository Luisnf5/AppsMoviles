<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tm_background"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp">

        <ImageButton
            android:id="@+id/btnCloseAchievements"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:alpha="0.6"
            android:background="@drawable/bg_home_social_circle"
            android:contentDescription="@string/cd_close"
            android:padding="14dp"
            android:src="@drawable/ic_close"
            app:tint="@android:color/white" />

        <LinearLayout
            android:id="@+id/achievementsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="68dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAchievementsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/achievements_title"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="32sp"
                android:textStyle="bold|italic"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:id="@+id/tvAchievementsSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.3"
                android:text="@string/achievements_subtitle"
                android:textAllCaps="true"
                android:textColor="@color/tm_pink"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_achievement_stat_card"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvUnlockedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/9"
                        android:textColor="@android:color/white"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.25"
                        android:text="@string/achievements_unlocked_counter"
                        android:textAllCaps="true"
                        android:textColor="#66FFFFFF"
                        android:textSize="8sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_achievement_stat_card"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/achievements_xp_value"
                        android:textColor="@color/tm_pink"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.15"
                        android:text="@string/achievements_xp_label"
                        android:textAllCaps="true"
                        android:textColor="#66FFFFFF"
                        android:textSize="8sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAchievements"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_above="@id/bottomAchievementsNav"
            android:layout_below="@id/achievementsHeader"
            android:layout_marginTop="28dp"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

        <LinearLayout
            android:id="@+id/bottomAchievementsNav"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_alignParentBottom="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/navPlayersFromAchievements"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="JUGADORES"
                android:textColor="#66FFFFFF"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/navRulesFromAchievements"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="REGLAS"
                android:textColor="#66FFFFFF"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/navAchievementsActive"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="LOGROS"
                android:textColor="@color/tm_pink"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/navProfileFromAchievements"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="PERFIL"
                android:textColor="#66FFFFFF"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

    </RelativeLayout>
</layout>