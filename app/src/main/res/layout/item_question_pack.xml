<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/itemPackRoot"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_pack_item_unselected"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="18dp">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_pack_icon">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivPackIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_book_open"
                app:tint="@color/tm_pink" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPackName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fiesta Clásica"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPackDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Preguntas básicas para empezar suave."
                android:textColor="#77FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvPackType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="PREDETERMINADO"
                android:textColor="@color/tm_pink"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivPackSelected"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_check"
            app:tint="@color/tm_pink" />

    </LinearLayout>
</layout>