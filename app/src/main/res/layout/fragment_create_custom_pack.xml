<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tm_background"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/btnCloseCreatePack"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:alpha="0.6"
            android:background="@drawable/bg_home_social_circle"
            android:contentDescription="@string/cd_close"
            android:padding="14dp"
            android:src="@drawable/ic_close"
            app:tint="@android:color/white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/btnCloseCreatePack"
            android:layout_marginTop="32dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/create_pack_title"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="32sp"
                android:textStyle="bold|italic"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.2"
                android:text="@string/create_pack_subtitle"
                android:textAllCaps="true"
                android:textColor="@color/tm_pink"
                android:textSize="10sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPackName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="42dp"
                android:background="@drawable/bg_players_input"
                android:hint="@string/create_pack_name_hint"
                android:inputType="textCapSentences"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:textColor="@android:color/white"
                android:textColorHint="#44FFFFFF"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etPackDescription"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_players_input"
                android:gravity="top"
                android:hint="@string/create_pack_description_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:padding="22dp"
                android:textColor="@android:color/white"
                android:textColorHint="#44FFFFFF"
                android:textSize="14sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnCreatePack"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:background="@drawable/bg_game_confirm_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/create_pack_button"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black" />

        </LinearLayout>

    </RelativeLayout>
</layout>