    <string name="rules_step_1_title">The Chosen One</string>
    <string name="rules_step_1_heading">1. The Chosen One</string>
    <string name="rules_step_1_desc">The app picks a \'subject\' from the group. Pass the phone to that person (carefully, no broken screens!).</string>

    <string name="rules_step_2_title">The Inquisition</string>
    <string name="rules_step_2_heading">2. The Inquisition</string>
    <string name="rules_step_2_desc">A question about the subject appears. The group must secretly debate and choose a unanimous answer.</string>

    <string name="rules_step_3_title">The Verdict</string>
    <string name="rules_step_3_heading">3. The Verdict</string>
    <string name="rules_step_3_desc">The subject reveals the truth. Did the group guess right? If they did, the subject drinks as many sips as beers shown for failing to hide their secrets.</string>

    <string name="rules_step_4_title">Group Punishment</string>
    <string name="rules_step_4_heading">4. Group Punishment</string>
    <string name="rules_step_4_desc">If the group fails, everyone drinks that number of sips except the subject. Be good friends and don\'t fail!</string>

    <string name="rules_pro_tip">PRO TIP</string>
    <string name="rules_tip_text">"If you don\'t know the answer, make up the funniest one. In the end, what matters is staying hydrated with joy."</string>
